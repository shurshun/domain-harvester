# Self-contained build from source, for local development:
#   docker build -f Dockerfile.local -t domain-harvester:dev .
# The release image (Dockerfile) instead copies a goreleaser-built binary.
FROM golang:1.26-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/domain-harvester ./cmd/domain-harvester

FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

COPY --from=build /out/domain-harvester /domain-harvester

USER nonroot:nonroot

ENTRYPOINT ["/domain-harvester"]
